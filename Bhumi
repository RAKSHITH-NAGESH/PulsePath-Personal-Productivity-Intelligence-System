class Solution:
    def palindromePath(self, n, edges, s, queries):
        from collections import deque

        g = [[] for _ in range(n)]
        for u, v in edges:
            g[u].append(v)
            g[v].append(u)

        LOG = n.bit_length()
        parent = [-1] * n
        depth = [0] * n
        tin = [0] * n
        size = [1] * n
        pref = [0] * n
        order = []
        stack = [0]
        timer = 0
        parent[0] = 0

        while stack:
            u = stack.pop()
            tin[u] = timer
            timer += 1
            order.append(u)
            pref[u] = (pref[parent[u]] if u else 0) ^ (1 << (ord(s[u]) - 97))

            for v in g[u]:
                if v != parent[u]:
                    parent[v] = u
                    depth[v] = depth[u] + 1
                    stack.append(v)

        for u in reversed(order[1:]):
            size[parent[u]] += size[u]

        tout = [tin[u] + size[u] for u in range(n)]

        up = [parent]
        for j in range(1, LOG):
            prev = up[-1]
            up.append([prev[prev[i]] for i in range(n)])

        bit = [0] * (n + 1)

        def update(i, val):
            i += 1
            while i <= n:
                bit[i] ^= val
                i += i & -i

        def query(i):
            res = 0
            i += 1
            while i > 0:
                res ^= bit[i]
                i -= i & -i
            return res

        def lca(u, v):
            if depth[u] < depth[v]:
                u, v = v, u

            diff = depth[u] - depth[v]
            j = 0
            while diff:
                if diff & 1:
                    u = up[j][u]
                diff >>= 1
                j += 1

            if u == v:
                return u

            for j in range(LOG - 1, -1, -1):
                if up[j][u] != up[j][v]:
                    u = up[j][u]
                    v = up[j][v]

            return parent[u]

        ans = []
        chars = list(s)

        for q in queries:
            parts = q.split()

            if parts[0] == "update":
                u = int(parts[1])
                c = parts[2]

                if chars[u] != c:
                    delta = (1 << (ord(chars[u]) - 97)) ^ (1 << (ord(c) - 97))
                    update(tin[u], delta)
                    if tout[u] < n:
                        update(tout[u], delta)
                    chars[u] = c

            else:
                u, v = int(parts[1]), int(parts[2])
                w = lca(u, v)

                mask_u = pref[u] ^ query(tin[u])
                mask_v = pref[v] ^ query(tin[v])
                mask = mask_u ^ mask_v ^ (1 << (ord(chars[w]) - 97))

                ans.append(mask == 0 or (mask & (mask - 1)) == 0)

        return ans
